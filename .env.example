# Copy to .env.local. Both keys are optional — the app runs without either.

# Reads real receipt photos and categorizes expenses.
# Without it, the receipt flow returns a fixed sample receipt and
# categorization falls back to keyword matching. Every other path — the
# splitting, the warnings, the arithmetic — is the same code either way.
ANTHROPIC_API_KEY=

# Only needed when ANTHROPIC_API_KEY is a personal/service-account key that
# isn't scoped to a single workspace — such keys must name the workspace on
# every request. Find the id (wrkspc_...) in Console → Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=
